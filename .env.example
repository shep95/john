# ---- john algro bot :: environment ----
# copy to .env for local runs, or set these as railway variables.

# safety: paper trading on live data is ON by default. set DRY_RUN=false to go live.
DRY_RUN=true

# hyperliquid account (only needed when DRY_RUN=false)
# use an API wallet / agent key, NOT your main withdrawal key.
HL_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=
HL_TESTNET=false

# market / symbol
SYMBOLS=KAS          # single symbol (Hyperliquid perp ticker); comma-separate to rotate
INTERVAL=5m
LEVERAGE=2           # 2x: participate without being enslaved to leverage
CROSS_MARGIN=false

# sizing / risk
PAPER_EQUITY=1000
RISK_FRAC=0.02
MAX_POSITION_FRAC=0.20   # <=20% of the account as notional per trade
SLIPPAGE=0.005           # 0.5%: wait for a good fill instead of chasing
MAX_DAILY_LOSS_PCT=0.06  # pause new entries after a 6% daily loss (0 = off)

# compounding: compound 40% of every profit into the sizing base, bank the other
# 60%. losses come fully out of the sizing base.
COMPOUND_FRAC=0.40
MIN_SIZING_BASE=10
MAX_SIZING_BASE=0        # ceiling on the sizing base (overflow is banked). 0 = no ceiling

# discord alerts + commands
#  - for the full bot (alerts + slash commands): set BOT_TOKEN + CHANNEL_ID
#    (+ GUILD_ID for instant slash-command sync in your server)
#  - for alerts only (no commands): set just WEBHOOK_URL
#  - USER_ID: your discord id, to get pinged on entry/exit
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=
DISCORD_USER_ID=

# analysis windows (matches the asherin.pine indicator inputs exactly)
WAR_WINDOW=7          # warWin
ATR_LOOKBACK=14       # atrLen
FRAME_LEN=50          # frameLen
NORMAL_LEN=50         # normLen
HISTORY_CANDLES=60    # 5h of 5m data is enough to read the present

# velocity / trend gates
TREND_THRESH=0.25     # |normVel| must clear this
DOM_THRESH=2.0        # |netForce| (sum body/atr) must clear this -- NOTE: net-force scale, not 0..1

# passion weights + threshold
W_MAG=0.20
W_CONF=0.35
W_WICK=0.25
W_PERS=0.20
PASSION_THRESH=1.00

# echo / normal rate
ECHO_TRIGGER=1.6
ECHO_MAX=6
ELONG_MULT=1.5
CONST_MULT=0.6

# stubborn / precursor / conflict
STUB_BODY=0.25
PREC_SIZE=0.60
PREC_COUNT=3
CONFLICT_THRESH=0.8
TAP_TOL=0.25
PIV_LEN=3

# SL/TP shaping (strength -> tighter SL, wider TP)
BASE_SL=2.0
BASE_TP=3.0
SL_SENS=0.60
TP_SENS=1.00
SL_FLOOR=0.50

# timing / cooldown (cooldown = last trade's duration)
POLL_SECONDS=20
COOLDOWN_MODE=trade_duration
MIN_COOLDOWN_SEC=1800     # 30m minimum rest between trades
MAX_COOLDOWN_SEC=14400
# trading-hours window (UTC): the bot only opens new trades inside it. 12 on / 12 off.
SESSION_START_HOUR=8
SESSION_END_HOUR=20

STATE_PATH=state.json
LOG_LEVEL=INFO

# scoreboard reset: to wipe pnl / win-rate / compounding and start fresh, change
# RESET_ID to any NEW value (e.g. a date or number) and redeploy -- it resets
# once. leave it unchanged to keep your running history. (also forgets learned rules)
RESET_ID=

# self-reflection / self-improvement: after each closed trade, once there are
# >= MIN_TRADES_TO_LEARN trades, john reviews its own history and may adopt a new
# entry filter (only ever making entries pickier -- never loosening risk). it is
# OFF by default (explicit opt-in); when on, it alerts you before each change.
# report-only when off (see the /reflect command).
SELF_LEARN=false
MIN_TRADES_TO_LEARN=20
LEARN_MARGIN=0.50        # need >=0.5R improvement to adopt a rule (signal, not noise)
LEARN_KEEP_FRAC=0.75     # an adopted rule must keep >=75% of trades (no overfitting)
