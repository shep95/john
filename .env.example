# ---- john bot :: environment ----
# copy to .env for local runs, or set these as railway variables.

# safety: paper trading on live data is ON by default. set DRY_RUN=false to go live.
DRY_RUN=true

# hyperliquid account (only needed when DRY_RUN=false)
# use an API wallet / agent key, NOT your main withdrawal key.
HL_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=
HL_TESTNET=false

# market
SYMBOLS=KAS              # comma-separate for several; one position at a time across all
INTERVAL=1h              # 1h default. 5m works but costs eat most of a normal move
ENGINE=projection        # which simulated engine the bot follows: projection | framework | asherin
WARMUP_CANDLES=5000      # replayed at boot so memory + the record exist immediately
LEVERAGE=2
CROSS_MARGIN=false

# sizing / risk
PAPER_EQUITY=1000
RISK_FRAC=0.01           # 1% of the sizing base between entry and stop
MAX_POSITION_FRAC=0.20   # notional cap = base × leverage × this
SLIPPAGE=0.005           # worst price a market entry accepts (a limit, not an estimate)
COMPOUND_FRAC=0.40       # 40% of each profit compounds into the sizing base, 60% is banked
MIN_SIZING_BASE=10
MAX_SIZING_BASE=0        # 0 = no ceiling

# live-account circuit breakers (never touch the simulated record)
MAX_DAILY_LOSS_PCT=0.06          # resumes automatically the next UTC day
MAX_CONSECUTIVE_LOSSES=4         # then a timed pause …
LOSS_STREAK_PAUSE_SEC=43200      # … of 12h
MAX_DRAWDOWN_PCT=0.15            # pauses until /resume

# validation gate — real orders only when the record proves an edge.
# the record is the indicator's simulated book: fixed parameters, costs included,
# pattern memory that only learns from outcomes that already happened.
REQUIRE_VALIDATED_EDGE=true
MIN_VALIDATION_TRADES=30
MIN_EXPECTANCY_R=0.05
MIN_EDGE_T=2.0           # mean R divided by its standard error (2.0 ≈ 2.3% chance of luck per test)
RECENT_TRADES=30         # the last N trades must also be positive
BASELINE_MIN_TRADES=10   # must beat momentum + random once they have this many trades

# indicator inputs — every shepherd.pine input can be overridden with SH_<NAME>
# (names in john_bot/shepherd.py Params). examples:
# SH_SEG_MULT=1.5
# SH_WIN=7
# SH_COST_PCT=0.12       # round-trip cost the sim charges: fees + spread + slippage
# SH_THIN_VOL=0.6        # 0 disables the thin-volume check

# discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=
DISCORD_USER_ID=

POLL_SECONDS=20
STATE_PATH=state.json
LOG_LEVEL=INFO
# change to any new value and redeploy to wipe pnl / win-rate / compounding once
RESET_ID=
